# 이 파일을 복사해 backend/.env를 만들고 실제 값을 채우세요.
#   cp backend/.env.example backend/.env
# .env는 .gitignore에 등록되어 있어 커밋되지 않습니다.
ENABLE_DEV_TOOLS=1
# ===== LLM API Keys =====
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# AI 플레이어 모델 (기본값 claude-haiku-5-5)
AI_MODEL=claude-haiku-5-5

# ===== Backend =====
PORT=8000
CLIENT_ORIGIN=http://localhost:3000
